{
  "name": "@conty/node",
  "version": "0.4.0",
  "description": "Conty server SDK: conversion events and the public campaigns API for integrations and AI agents",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Conty-App/conty-sdk.git",
    "directory": "packages/node"
  },
  "homepage": "https://help.appconty.com/api/guias/eventos-de-conversao",
  "bugs": {
    "url": "https://github.com/Conty-App/conty-sdk/issues"
  },
  "keywords": [
    "conty",
    "conversion",
    "attribution",
    "events",
    "server",
    "campaigns",
    "creators",
    "influencer-marketing",
    "public-api",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "openapi:types": "openapi-typescript ../../test/fixtures/openapi.json -o src/api/generated/openapi.ts"
  },
  "devDependencies": {
    "@conty/core": "*",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.9"
  }
}
