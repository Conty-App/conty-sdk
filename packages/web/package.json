{
  "name": "@conty/web",
  "version": "0.1.0",
  "description": "Conty browser SDK: conversion events with creator attribution",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Conty-App/conty-sdk.git",
    "directory": "packages/web"
  },
  "homepage": "https://help.appconty.com/api/guias/eventos-de-conversao",
  "bugs": {
    "url": "https://github.com/Conty-App/conty-sdk/issues"
  },
  "keywords": [
    "conty",
    "conversion",
    "attribution",
    "utm",
    "analytics"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/sdk.js",
  "jsdelivr": "./dist/sdk.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sdk.js": "./dist/sdk.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/sdk.js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@conty/core": "*",
    "jsdom": "^27.4.0",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "vitest": "^4.1.9"
  }
}
